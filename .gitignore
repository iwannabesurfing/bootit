# Build output
.build/
dist/
*.zip
*.dmg

# Vendored wimlib binaries — regenerated by mac/vendor-wimlib.sh from a Homebrew
# wimlib on the build machine; not source, so not tracked.
mac/vendor/

# Local Claude Code settings — but session continuity is not "local settings".
# The log, promotion queue and run receipts are the record of what happened and
# why, and they have to survive a fresh clone.
.claude/*
!.claude/session-log.md
!.claude/promotion-queue/
!.claude/receipts/

# macOS cruft
.DS_Store

# Xcode user data (only relevant if an .xcodeproj is ever added)
xcuserdata/
DerivedData/
*.xcuserstate

# Xcode's per-user package state — window layout and which scheme was last
# selected. The schemes themselves are generated from Package.swift's products,
# so nothing here is needed to reproduce the preview setup.
mac/.swiftpm/
