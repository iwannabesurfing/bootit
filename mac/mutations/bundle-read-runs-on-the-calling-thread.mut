# Restores the synchronous main-thread stat. On a stalled network mount this is the
# app beachballing every time it comes to the front.
filter: BundleReadingLatency
file: Sources/BootItKit/AppModel.swift
--- old ---
            self.bundleReader.async { [weak self] in
                let current = read()
                self?.onMain {
                    self?.bundleReadingInFlight = false
                    self?.preflight.noteBundleReading(current)
                }
            }
--- new ---
            let current = read()
            self.bundleReadingInFlight = false
            self.preflight.noteBundleReading(current)
